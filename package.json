{
	"name": "@rebuildup/tool-fillgen",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"check": "biome check --write --no-errors-on-unmatched",
		"lint": "biome lint",
		"format": "biome format --write",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage",
		"verify": "bun run check && bun run typecheck && bun run test"
	},
	"dependencies": {
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^5.2.0",
		"@vitest/coverage-v8": "^2.1.8",
		"happy-dom": "^15.11.7",
		"typescript": "^5.7.2",
		"vite": "^7.3.7",
		"vitest": "^2.1.8"
	},
	"license": "MIT"
}
